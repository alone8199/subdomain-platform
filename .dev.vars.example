# ============================================================
# 本地开发用的环境变量（wrangler dev 会读取 .dev.vars）
# 复制本文件为 .dev.vars 并填入真实值。.dev.vars 切勿提交到仓库。
# 生产环境请用 `wrangler secret put <NAME>` 设置敏感项，不要写进 wrangler.toml。
# ============================================================

# 初始化管理员邮箱（首次 /setup 时校验，必须与这里一致）
ADMIN_EMAIL=admin@example.com

# 初始化管理员密码（首次 /setup 时用于创建管理员账号）
ADMIN_INITIAL_PASSWORD=change-me-strong-password

# 初始化令牌：调用 /api/auth/setup 时必须携带，防止被抢注
SETUP_TOKEN=change-me-setup-token

# Cloudflare API Token（最小权限：Zone:Read、DNS:Edit）
CF_API_TOKEN=your-cloudflare-api-token

# Cloudflare 账户 ID
CF_ACCOUNT_ID=your-cloudflare-account-id
